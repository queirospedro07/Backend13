# LearnSpace Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT Configuration
# In production, replace with a strong 256-bit cryptographically random secret string.
# Example command to generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=learnspace-super-secure-production-ready-jwt-secret-key-32-chars
JWT_EXPIRES_IN=7d

# Demo accounts disabled by default for real user safety
ENABLE_DEMO_LOGIN=false
